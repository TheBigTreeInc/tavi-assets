{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBigTreeInc/tavi-assets/blob/main/schemas/catalog.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schematics", "packs"],
  "properties": {
    "schema": {"const": "tavi.assets.repository-index/v1"},
    "schematics": {"type": "array", "items": {"$ref": "#/$defs/release"}},
    "packs": {"type": "array", "items": {"$ref": "#/$defs/release"}}
  },
  "$defs": {"release": {"type": "object", "additionalProperties": false,
    "required": ["id", "version", "artifact", "bytes", "sha256", "status", "approvalReference"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"},
      "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
      "artifact": {"type": "string", "minLength": 1},
      "bytes": {"type": "integer", "minimum": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "status": {"const": "approved"},
      "approvalReference": {"type": "string", "minLength": 5},
      "blueprintId": {"type": "string"},
      "blueprintSchema": {"const": "tavix.studio.asset-blueprint/v1"},
      "compatibility": {"type": "object"}
    }
  }}
}
