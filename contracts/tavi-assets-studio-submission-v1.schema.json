{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tavi Asset Studio staging request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "packId",
    "version",
    "archiveSha256",
    "archiveBytes",
    "destination",
    "requiresHostApproval",
    "requiresServerAuthorization"
  ],
  "properties": {
    "schema": {
      "const": "tavi.assets.studio-submission/v1"
    },
    "operation": {
      "const": "request_stage"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archiveBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "destination": {
      "const": "staging"
    },
    "requiresHostApproval": {
      "const": true
    },
    "requiresServerAuthorization": {
      "const": true
    }
  }
}
