{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBigTreeInc/tavi-assets/contracts/tavi-assets-store-offer-v1.schema.json",
  "title": "Proposed untrusted storefront offer display (not a payment authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "entitlementId",
    "contents"
  ],
  "properties": {
    "schema": {
      "const": "tavi.assets.store-offer/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "entitlementId": {
      "$ref": "#/$defs/id"
    },
    "displayGoldPrice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Illustrative storefront price ONLY; never authorize a transaction from this field"
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packId"
        ],
        "properties": {
          "packId": {
            "$ref": "#/$defs/id"
          },
          "capability": {
            "$ref": "#/$defs/id"
          },
          "variant": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
    }
  }
}
